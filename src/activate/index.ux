    flex-direction: column;
    width: 100%;
    align-items: center;
    padding-bottom: 40px; /* Add padding for scrolling */
  }
  .device-code-section, .activation-code-section {
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px; /* Increased by 25% from 20px */
  }
  .device-code-section text, .activation-code-section text { color: #AAA; font-size: 28px; margin-bottom: 10px; }
  .code-box, .input-box {
    width: 90%; /* Use percentage for responsiveness */

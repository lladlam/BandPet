<template>
  <stack class="page-container">
    <!-- Main content container -->
    <div style="width: 100%; height: 100%; flex-direction: column; align-items: center;">
      <div class="page-header-container">
        <div class="page-header">
          <!-- Back button moved to top layer of stack -->
          <div class="header-title-time">
            <text class="page-time-display">{{ time }}</text>
            <text class="page-header-title">物品交换</text>
          </div>
        </div>
      </div>
      <div class="page-content">
        <text class="placeholder-text">功能暂未开放</text>
      </div>
    </div>
    <!-- Back Button on top layer for guaranteed clickability -->
    <image src="../common/back.png" class="page-header-back-button" onclick="goBack" style="top: 5px;"></image>
  </stack>
</template>

<style>
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center; /* Center title block */
    position: relative; /* Anchor for back button */
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    flex: 1; /* Take up remaining vertical space */
    align-items: center;
    overflow: scroll; /* Allow content to scroll */
  }
  .placeholder-text {
      margin-top: 100px;
      color: #FFFFFF;
      font-size: 30px;
  }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import prompt from '@system.prompt';
  import { CONFIG } from '../common/js/config.js';

  const _promisifiedStorageGet = (key) => {
    return new Promise((resolve) => {
      storage.get({
        key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      });
    });
  };

  export default {
    data: {
      time: '00:00',
      timeInterval: null
    },
    async onInit() {
      const offlineSetting = await _promisifiedStorageGet(CONFIG.STORAGE_KEYS.OFFLINE_MODE_ENABLED);
      if (offlineSetting === 'true') {
        prompt.showToast({ message: '离线模式下无法使用物品交换' });
        router.back();
        return;
      }

      this.updateTime();
      this.timeInterval = setInterval(this.updateTime, 10000);
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    goBack() {
      router.back();
    },
    onDestroy() {
      if (this.timeInterval) {
        clearInterval(this.timeInterval);
        this.timeInterval = null;
      }
    }
  }
</script>

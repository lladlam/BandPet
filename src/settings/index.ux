<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">设置</text>
        </div>
      </div>
    </div>
    <div class="page-content">
      <div class="settings-content">
        <div class="info-item">
          <text class="info-label">您的宠物:</text>
          <text class="info-value">{{ petName }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">ID:</text>
          <text class="info-value">{{ userId }}</text>
        </div>
      </div>
    </div>
    <div class="about-button" onclick="goToAbout">
        <text class="about-button-text">关于</text>
    </div>
  </div>
</template>

<style>
  .page-container {
    position: relative; /* Add this for absolute positioning context */
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1E90FF;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
    align-items: center;
  }
  .settings-content {
    flex-direction: column;
    width: 90%;
    margin-top: 10px;
  }
  .info-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 20px;
    background-color: #1A1A1A; /* Even darker grey */
    border-radius: 15px;
  }
  .info-label {
    color: #AAAAAA;
    font-size: 30px;
  }
  .info-value {
    color: #FFFFFF;
    font-size: 30px;
  }
  .about-button {
    position: absolute;
    right: 20px;
    bottom: 30px;
    width: 120px;
    height: 60px;
    background-color: #1A1A1A; /* Even darker grey */
    border-radius: 30px;
    justify-content: center;
    align-items: center;
  }
  .about-button-text {
    color: #FFFFFF;
    font-size: 30px;
  }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import { CONFIG } from '../common/js/config.js';

  export default {
    data: {
      time: '00:00',
      petName: '加载中...',
      userId: '加载中...'
    },
    onInit() {
      this.loadUserInfo();
      this.updateTime();
      setInterval(this.updateTime, 5000); // Update every 5 seconds
    },
    async loadUserInfo() {
      try {
        const userInfoResult = await storage.get({ key: CONFIG.STORAGE_KEYS.USER_INFO });
        if (userInfoResult.value) {
          const userInfo = JSON.parse(userInfoResult.value);
          if (userInfo) {
            this.petName = userInfo.pet_name || '(无名)';
            this.userId = userInfo.id || '无';
          } else {
            this.petName = '(未激活)';
            this.userId = '无';
          }
        } else {
            this.petName = '(未激活)';
            this.userId = '无';
        }
      } catch (e) {
        console.error("Error loading user info in settings:", e);
        this.petName = '加载失败';
        this.userId = '加载失败';
      }
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    goBack() {
      router.back();
    },
    goToAbout() {
      router.push({
        uri: 'about'
      });
    }
  }
</script>
<script>
  import UserService from './common/js/userService.js';
  import BackInterceptor from './common/js/back-interceptor.js';
  import storage from '@system.storage';
  import { CONFIG } from './common/js/config.js';

  const _promisifiedStorageGet = (key) => {
    return new Promise((resolve) => {
      storage.get({
        key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      });
    });
  };

  export default {
    onCreate() {
      console.log('[lifecycle] [app] onCreate - App is starting...');
    },

    onShow() {
      console.log('[lifecycle] [app] onShow');
    },

    async onHide() {
      console.log('[lifecycle] [app] onHide - Triggering final click sync before exit.');

      const offlineSetting = await _promisifiedStorageGet(CONFIG.STORAGE_KEYS.OFFLINE_MODE_ENABLED);
      if (offlineSetting === 'true') {
        console.log('[lifecycle] [app] onHide - Offline mode enabled, skip final sync.');
        return;
      }

      UserService.triggerClickSync();
    },

    onDestroy() {
      console.log('[lifecycle] [app] onDestroy');
      // 清理返回键拦截器，以防万一
      BackInterceptor.restore();
    },

    onError(err) {
      console.log(`[lifecycle] [app] onError errmsg: ${err.message}`);
      console.log(`[lifecycle] [app] onError error stack: ${err.stack}`);
    }
  }
</script>

<template>
  <div class="page-container">
    <div class="page-header-container" show="{{!showKeyboard}}">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">宠物命名</text>
        </div>
      </div>
    </div>
    <div class="page-content" show="{{!showKeyboard}}">
      <div class="content-container">
        <div class="current-name-section">
          <text>当前名字: {{ currentPetName }}</text>
        </div>
        <div class="name-input" onclick="toggleKeyboard(true)">
          <text>{{ newPetName || '点击输入新名字' }}</text>
        </div>
        <image src="../common/check.png" class="confirm-button" onclick="savePetName"></image>
        <text class="status-text">{{ statusMessage }}</text>
      </div>
    </div>
    <QwertyKeyboard show="{{showKeyboard}}" onkeyclick="handleKeyClick"></QwertyKeyboard>
  </div>
</template>

<style>
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-top: 0;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-top: 10px;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1E90FF;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .page-header-back-arrow {
    color: #FFFFFF;
    font-size: 50px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
    align-items: center;
  }
  .content-container { flex-direction: column; align-items: center; }
  .current-name-section { flex-direction: column; align-items: center; margin-bottom: 30px; }
  .current-name-section text { color: #AAA; font-size: 28px; margin-bottom: 10px; }
  .name-input { width: 400px; height: 70px; background-color: #1A1A1A; border-radius: 15px; justify-content: flex-start; align-items: center; padding-left: 20px; margin-bottom: 40px; }
  .name-input text { color: #FFF; font-size: 32px; }
  .confirm-button { width: 100px; height: 100px; border-radius: 50px; background-color: #007AFF; justify-content: center; align-items: center; }
  .confirm-icon { color: #FFF; font-size: 60px; }
  .status-text { color: #FF3B30; font-size: 24px; margin-top: 20px; }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import ApiService from '../common/js/api-service.js';
  import { auth } from '../common/js/auth.js';
  import { CONFIG } from '../common/js/config.js';
  import QwertyKeyboard from '../common/QwertyKeyboard.ux';

  export default {
    components: {
      QwertyKeyboard
    },
    data: {
      time: '00:00',
      currentPetName: '...',
      newPetName: '',
      userId: null,
      statusMessage: '',
      showKeyboard: false
    },
    async onInit() {
      this.updateTime();
      setInterval(this.updateTime, 60000);

      const { isActivated, userInfo } = await auth.getActivationState();
      if (isActivated && userInfo) {
        this.userId = userInfo.id;
        this.currentPetName = userInfo.pet_name || '(无名)';
      } else {
        this.currentPetName = '(请先激活)';
      }
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    toggleKeyboard(show) {
      this.showKeyboard = show;
    },
    handleKeyClick(e) {
      const key = e.detail.value;
      if (key === '⌫') {
        this.newPetName = this.newPetName.slice(0, -1);
      } else if (key === '✓') {
        this.toggleKeyboard(false);
        this.savePetName();
      } else if (key === 'Space') {
        this.newPetName += ' ';
      } else if (key !== 'Shift') {
        this.newPetName += key;
      }
    },
    async savePetName() {
      const { isActivated, userInfo } = await auth.getActivationState();
      if (!isActivated) {
        this.statusMessage = '请先激活';
        setTimeout(() => router.push({ uri: 'activate' }), 1000);
        return;
      }

      if (!this.newPetName || this.newPetName.length > 10) {
        this.statusMessage = '名字需在1-10个字符之间';
        return;
      }
      this.statusMessage = '正在保存...';

      const result = await ApiService.setPetName(this.userId, this.newPetName);

      if (result.success) {
        this.currentPetName = this.newPetName;
        this.statusMessage = '宠物名字已更新！';
        
        const updatedUserInfo = { ...userInfo, pet_name: this.newPetName };
        storage.set({
          key: CONFIG.STORAGE_KEYS.USER_INFO,
          value: JSON.stringify(updatedUserInfo)
        });

      } else {
        this.statusMessage = `保存失败: ${result.error || '未知错误'}`;
      }
    },
    goBack() {
      if (this.showKeyboard) {
        this.toggleKeyboard(false);
      } else {
        router.back();
      }
    }
  }
</script>

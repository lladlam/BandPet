<template>
  <div class="keyboard-container" show="{{show}}">
    <div class="keyboard-grid">
      <div for="{{ row in keys }}" class="keyboard-row">
        <div for="{{ key in row }}" class="key" onclick="onKeyClick(key)">
          <text class="key-text">{{ key }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .keyboard-container {
    /* Removed absolute positioning */
    /* bottom: 0; */
    /* left: 0; */
    /* width: 100%; */
    background-color: #000000;
    flex-direction: column;
    align-items: center;
    padding: 10px;
    border: 1px solid red; /* Debugging border */
  }
  .keyboard-grid {
    width: 100%;
    flex-direction: column;
  }
  .keyboard-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
  }
  .key {
    width: 120px; /* Adjusted from 140px */
    height: 70px; /* Adjusted from 80px */
    background-color: #2c2c2e;
    border-radius: 15px;
    margin: 0 5px;
    justify-content: center;
    align-items: center;
  }
  .key-text {
    color: #FFFFFF;
    font-size: 28px; /* Reduced font size */
  }
</style>

<script>
  export default {
    data: {
      show: false, // Move show back to data
      keys: [
        ['1', '2', '3'],
        ['4', '5', '6'],
        ['7', '8', '9'],
        ['⌫', '0', '✓'] // Using symbols for backspace and confirm
      ]
    },
    onKeyClick(key) {
      this.$emit('keyclick', { value: key });
    }
  }
</script>

<template>
  <div class="page-container">
    <div class="page-header">
      <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
      <div class="header-content">
        <text class="page-time-display">{{ time }}</text>
        <text class="page-header-title">更多</text>
      </div>
    </div>
    
    <list class="menu-list">
      <list-item
        type="default"
        class="menu-item"
        for="{{ menuItems }}"
        onclick="goTo($item.uri)">
        <text class="menu-text">{{$item.title}}</text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .header-content {
    flex-direction: column;
    align-items: center;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .menu-list {
    flex: 1; /* Let the list take the remaining space */
    width: 100%;
    padding: 0 20px;
  }
  .menu-item {
    width: 100%;
    height: 90px;
    border-radius: 20px;
    background-color: #1A1A1A;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }
  .menu-text {
    color: #FFFFFF;
    font-size: 35px;
  }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import { CONFIG } from '../common/js/config.js';

  const _promisifiedStorageGet = (key) => {
    return new Promise((resolve) => {
      storage.get({
        key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      });
    });
  };

  export default {
    data: {
      time: '00:00',
      offlineModeEnabled: false,
      menuItems: []
    },
    async onInit() {
      this.updateTime();
      await this.loadOfflineModeSetting();
      this.rebuildMenuItems();
      setInterval(this.updateTime, 10000);
    },
    async onShow() {
      await this.loadOfflineModeSetting();
      this.rebuildMenuItems();
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    async loadOfflineModeSetting() {
      try {
        const setting = await _promisifiedStorageGet(CONFIG.STORAGE_KEYS.OFFLINE_MODE_ENABLED);
        this.offlineModeEnabled = setting === 'true';
      } catch (e) {
        this.offlineModeEnabled = false;
      }
    },
    rebuildMenuItems() {
      const items = [];

      if (!this.offlineModeEnabled) {
        items.push(
          { title: '公告', uri: 'announcement' },
          { title: '排行榜', uri: 'leaderboard' },
          { title: '物品交换', uri: 'exchange' },
          { title: '物品市场', uri: 'market' }
        );
      }

      items.push(
        { title: '自定义宠物', uri: 'customize' },
        { title: '设置', uri: 'settings' }
      );

      this.menuItems = items;
    },
    goBack() {
      router.back();
    },
    goTo(page) {
      router.push({ uri: page });
    }
  }
</script>

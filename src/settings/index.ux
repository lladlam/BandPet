  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1E90FF;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
    align-items: center;
  }
  .settings-content {
    flex-direction: column;
    width: 90%;
    margin-top: 10px;
  }
  .info-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 20px;
    background-color: #1A1A1A; /* Even darker grey */
    border-radius: 15px;
  }

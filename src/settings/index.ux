<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">设置</text>
        </div>
      </div>
    </div>
    <div class="page-content">
      <div class="settings-content">
        <div class="info-item">
          <text class="info-label">您的宠物:</text>
          <text class="info-value">{{ petName }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">ID:</text>
          <text class="info-value">{{ userId }}</text>
        </div>
        
        <!-- 更多选项按钮 -->
        <div class="menu-button" onclick="goToMoreOptions">
          <text class="menu-button-text">更多选项</text>
        </div>
      </div>
    </div>
    <div class="sync-button" onclick="goToSync" show="{{ !offlineModeEnabled }}">
        <text class="sync-button-text">云端同步</text>
    </div>
    <div class="about-button" onclick="goToAbout">
        <text class="about-button-text">关于</text>
    </div>
  </div>
</template>

<style>
  .page-container {
    position: relative;
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    flex: 1;
    align-items: center;
    overflow: scroll;
  }
  .settings-content {
    flex-direction: column;
    width: 90%;
    margin-top: 10px;
  }
  .info-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 20px;
    background-color: #1A1A1A;
    border-radius: 15px;
  }
  .info-label {
    color: #AAAAAA;
    font-size: 30px;
  }
  .info-value {
    color: #FFFFFF;
    font-size: 30px;
  }
  .menu-button {
    width: 100%;
    height: 70px;
    background-color: #1A1A1A;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
  }
  .menu-button-text {
    color: #FFFFFF;
    font-size: 30px;
  }
  .about-button, .sync-button {
    position: absolute;
    bottom: 30px;
    width: 140px;
    height: 60px;
    background-color: #1A1A1A;
    border-radius: 30px;
    justify-content: center;
    align-items: center;
  }
  .about-button {
    right: 20px;
  }
  .sync-button {
    left: 20px;
  }
  .about-button-text, .sync-button-text {
    color: #FFFFFF;
    font-size: 28px;
  }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import { CONFIG } from '../common/js/config.js';

  // Promisified helper for storage.get to handle async/await correctly.
  const _promisifiedStorageGet = (key) => {
    return new Promise((resolve) => {
      storage.get({
        key: key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      });
    });
  };

  export default {
    data: {
      time: '00:00',
      petName: '加载中...',
      userId: '加载中...',
      offlineModeEnabled: false,
      timeInterval: null
    },
    async onInit() {
      this.loadUserInfo();
      await this.loadOfflineModeSetting();
      this.updateTime();
      this.timeInterval = setInterval(this.updateTime, 10000);
    },
    async onShow() {
      await this.loadOfflineModeSetting();
    },
    async loadUserInfo() {
      try {
        const userInfoJSON = await _promisifiedStorageGet(CONFIG.STORAGE_KEYS.USER_INFO);

        if (userInfoJSON) {
          const userInfo = JSON.parse(userInfoJSON);
          if (userInfo && userInfo.id) {
            this.petName = userInfo.pet_name || '(无名)';
            this.userId = userInfo.id || '无';
          } else {
            this.petName = '信息无效';
            this.userId = '无';
          }
        } else {
            this.petName = '无信息';
            this.userId = '无';
        }
      } catch (e) {
        console.error("[SettingsPage] A critical error occurred while loading user info:", e);
        this.petName = '加载失败';
        this.userId = '加载失败';
      }
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    async loadOfflineModeSetting() {
      try {
        const setting = await _promisifiedStorageGet(CONFIG.STORAGE_KEYS.OFFLINE_MODE_ENABLED);
        this.offlineModeEnabled = setting === 'true';
      } catch (e) {
        this.offlineModeEnabled = false;
      }
    },
    goBack() {
      router.back();
    },
    goToSync() {
      router.push({
        uri: 'sync'
      });
    },
    goToAbout() {
      router.push({
        uri: 'about'
      });
    },
    goToMoreOptions() {
      router.push({
        uri: 'more-options'
      });
    },
    onDestroy() {
      if (this.timeInterval) {
        clearInterval(this.timeInterval);
        this.timeInterval = null;
      }
    }
  }
</script>

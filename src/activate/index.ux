    justify-content: center; /* Center placeholder text */
  }
  .input-box text {
      color: #FFF;
  }
  .actions { width: 100%; justify-content: center; margin-top: -1px; }
  .confirm-button { width: 40px; height: 40px; border-radius: 50px; background-color: #007AFF; justify-content: center; align-items: center; }
  .confirm-icon { color: #FFF; font-size: 40px; /* Adjusted from 60px */ }

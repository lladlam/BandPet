<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">{{ uiState === 'enter_user_id' ? '验证用户ID' : '激活' }}</text>
        </div>
      </div>
    </div>
    
    <scroll class="content-scroll-container">
      <div class="page-content">
        <div class="device-code-section">
          <text>您的设备码为</text>
          <div class="code-box">
            <!-- Display the processed code -->
            <text>{{ displayedDeviceCode }}</text>
          </div>
        </div>

        <!-- Activation Code Input State -->
        <div if="{{ uiState === 'enter_activation_code' }}" class="activation-code-section">
          <text>激活码</text>
          <div class="input-box">
            <text>{{ activationCode || '点击输入' }}</text>
          </div>
        </div>

        <!-- User ID Input State -->
        <div if="{{ uiState === 'enter_user_id' }}" class="activation-code-section">
          <text>用户ID</text>
          <div class="input-box">
            <text>{{ userIdInput || '点击输入用户ID' }}</text>
          </div>
        </div>

        <div class="actions">
          <!-- T9 Keyboard (template remains the same) -->
          <div class="t9-keyboard">
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '1'}})">
                <image src="../common/1.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '2'}})">
                <image src="../common/2.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '3'}})">
                <image src="../common/3.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '4'}})">
                <image src="../common/4.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '5'}})">
                <image src="../common/5.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '6'}})">
                <image src="../common/6.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '7'}})">
                <image src="../common/7.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '8'}})">
                <image src="../common/8.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '9'}})">
                <image src="../common/9.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '⌫'}})">
                <image src="../common/del.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '0'}})">
                <image src="../common/0.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '✓'}})">
                <image src="../common/SmallCheck.png" class="key-icon"></image>
              </div>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <text class="status-text">{{ statusMessage }}</text>
  </div>
</template>

<style>
  /* Styles remain unchanged */
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
    margin-top: 0;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    margin-right: 10px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: flex-start;
  }
  .content-scroll-container {
    flex: 1;
    width: 100%;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    align-items: center;
    padding-bottom: 40px;
  }
  .device-code-section, .activation-code-section {
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
  }
  .device-code-section text, .activation-code-section text { color: #AAA; font-size: 28px; margin-bottom: 10px; }
  .code-box, .input-box {
    width: 90%;
    height: 60px;
    background-color: #222;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
    padding: -1px 10px;
  }
  .code-box text {
    color: #FFF;
    font-size: 20px;
    text-overflow: ellipsis;
  }
  .input-box {
    color: #FFF;
    font-size: 20px;
    justify-content: center;
  }
  .input-box text {
      color: #FFF;
  }
  .actions { width: 100%; justify-content: center; margin-top: -1px; }
  .status-text { color: #FF3B30; font-size: 24px; margin-top: 20px; }
  .t9-keyboard {
    flex-direction: column;
    align-items: center;
    margin-top: -1px;
  }
  .keyboard-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: -1px;
  }
  .key {
    width: 80px;
    height: 80px;
    background-color: #2c2c2e;
    border-radius: 15px;
    margin: -20px 8px;
    justify-content: center;
    align-items: center;
  }
  .key-icon {
    width: 40px;
    height: 40px;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import storage from '@system.storage';
  import prompt from '@system.prompt';
  import ApiService from '../common/js/api-service.js';
  import { CONFIG } from '../common/js/config.js';

  export default {
    data: {
      time: '00:00',
      rawDeviceId: null, // To store the raw system identifier
      displayedDeviceCode: '正在生成...', // To store the processed code for display and local validation
      activationCode: '',
      userIdInput: '',
      statusMessage: '',
      uiState: 'enter_activation_code',
    },

    async onInit() {
      this.updateTime();
      setInterval(this.updateTime, 5000);
      
      const generated = await this.processDeviceIdentifier();
      if (generated) {
        this.attemptAutoActivation();
      } else {
        this.displayedDeviceCode = '获取失败';
        this.statusMessage = '无法获取设备标识，请重启应用。';
      }
    },

    // New centralized success handler
    async handleActivationSuccess(userInfo) {
      await storage.set({ 
        key: CONFIG.STORAGE_KEYS.IS_LOCALLY_ACTIVATED, 
        value: 'true' 
      });
      
      // The rawDeviceId is already saved in storage from processDeviceIdentifier
      
      const userInfoToSave = {
        id: userInfo.id || userInfo.user_number,
        user_number: userInfo.user_number,
        pet_name: userInfo.pet_name,
        total_clicks: userInfo.total_clicks || 0
      };
      await storage.set({ 
        key: CONFIG.STORAGE_KEYS.USER_INFO, 
        value: JSON.stringify(userInfoToSave) 
      });
      
      setTimeout(() => {
        router.replace({ uri: 'main' });
      }, 1000);
    },

    async attemptAutoActivation() {
      if (!this.rawDeviceId) return;
      this.statusMessage = '正在检查设备注册信息...';
      // Use rawDeviceId for server communication
      const result = await ApiService.checkDeviceRegistration(this.rawDeviceId);

      if (result.success && result.data && result.data.is_registered) {
        const { userInfo, auto_activation_count, reason } = result.data;

        if (reason === 'logged_in_on_newer_device') {
          this.statusMessage = '此设备之前绑定的用户已在其他设备上登录，请重新激活。';
          return;
        }

        if (result.data.can_auto_activate) {
          this.statusMessage = `自动激活成功！正在恢复数据... (${(auto_activation_count || 0) + 1}/5)`;
          await this.handleActivationSuccess(userInfo);
        } else {
          this.statusMessage = '自动激活次数已达上限，请手动激活。';
        }
      } else {
        this.statusMessage = ''; // Not registered or API failed
      }
    },

    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },

    goBack() {
      if (this.uiState === 'enter_user_id') {
        this.uiState = 'enter_activation_code';
        this.statusMessage = '';
        this.userIdInput = '';
      } else {
        router.back();
      }
    },

    handleKeyClick(e) {
      const key = e.detail.value;
      if (this.uiState === 'enter_user_id') {
        if (key === '⌫') this.userIdInput = this.userIdInput.slice(0, -1);
        else if (key === '✓') this.verifyUserIdAndProceed();
        else this.userIdInput += key;
      } else {
        if (key === '⌫') this.activationCode = this.activationCode.slice(0, -1);
        else if (key === '✓') this.activate();
        else this.activationCode += key;
      }
    },

    async verifyUserIdAndProceed() {
      if (!this.userIdInput || !this.rawDeviceId) return;
      this.statusMessage = '正在验证用户ID...';
      // Use rawDeviceId for server communication
      const result = await ApiService.verifyUserIdAndRestore(this.rawDeviceId, this.userIdInput);

      if (result.success && result.userInfo) {
        this.statusMessage = '验证成功，正在恢复数据...';
        await this.handleActivationSuccess(result.userInfo);
      } else {
        this.statusMessage = result.error || '用户ID验证失败，请重试。';
      }
    },

    // Renamed from generateDeviceCode to be more descriptive
    processDeviceIdentifier() {
      return new Promise((resolve) => {
        device.getSerial({
          success: (data) => {
            if (!data || !data.serial || data.serial === 'NA') {
              console.error('Failed to get serial: returned an invalid identifier:', data.serial);
              resolve(false);
              return;
            }
            
            // 1. Store the raw system identifier
            this.rawDeviceId = data.serial;
            
            // 2. Save the raw identifier to storage for the auth-guard
            storage.set({
              key: CONFIG.STORAGE_KEYS.DEVICE_ID,
              value: this.rawDeviceId,
              success: () => {
                // 3. Process the identifier for local activation logic
                let processedSerial = this.rawDeviceId.substring(0, 13).replace(/\//g, '');
                const letterToNumberMap = { 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5 };
                let numericSerial = '';
                for (let i = 0; i < processedSerial.length; i++) {
                  let char = processedSerial[i].toUpperCase();
                  if (char >= 'F' && char <= 'Z') char = 'E';
                  if (letterToNumberMap[char]) numericSerial += letterToNumberMap[char];
                  else if (!isNaN(parseInt(char, 10))) numericSerial += char;
                }
                if (numericSerial.length < 12) numericSerial = numericSerial.padEnd(12, '0');
                else if (numericSerial.length > 12) numericSerial = numericSerial.substring(0, 12);
                
                if (numericSerial.length !== 12 || !/^\d{12}$/.test(numericSerial)) {
                    console.error('Processed serial is not a 12-digit number.');
                    resolve(false);
                    return;
                }

                const pairs = numericSerial.match(/.{1,2}/g) || [];
                const selectedPairs = [pairs[0], pairs[2], pairs[4]];
                const sumAB = parseInt(selectedPairs[0][0], 10) + parseInt(selectedPairs[0][1], 10);
                const sumEF = parseInt(selectedPairs[1][0], 10) + parseInt(selectedPairs[1][1], 10);
                const sumIJ = parseInt(selectedPairs[2][0], 10) + parseInt(selectedPairs[2][1], 10);
                const sumBFJ = parseInt(selectedPairs[0][1], 10) + parseInt(selectedPairs[1][1], 10) + parseInt(selectedPairs[2][1], 10);
                
                // 4. Set the displayed code
                this.displayedDeviceCode = `${String(sumAB).padStart(2, '0')}${String(sumEF).padStart(2, '0')}${String(sumIJ).padStart(2, '0')}${String(sumBFJ).padStart(2, '0')}1`;
                
                console.log('Raw Device ID:', this.rawDeviceId);
                console.log('Displayed Device Code:', this.displayedDeviceCode);
                resolve(true);
              },
              fail: (err, code) => {
                console.error(`Failed to save raw device ID to storage. Code: ${code}, Error: ${err}`);
                resolve(false);
              }
            });
          },
          fail: (err, code) => {
            console.error(`Failed to get serial. Code: ${code}, Error: ${err}`);
            resolve(false);
          }
        });
      });
    },

    async activate() {
      if (!this.activationCode || this.activationCode.length !== 11) {
        this.statusMessage = "激活码长度不正确，应为11位";
        return;
      }

      // Step 1: Local validation against the processed/displayed code
      const ac = this.activationCode;
      const G_val = parseInt(ac[6], 10);
      const K_val = parseInt(ac[10], 10);
      const HI_modified_num = parseInt(`${ac[7]}${ac[8]}`, 10) - G_val - K_val;
      if (HI_modified_num < 0 || HI_modified_num > 99) {
        this.statusMessage = "激活失败: HI减法结果无效";
        return;
      }
      const HI_modified_str = String(HI_modified_num).padStart(2, '0');
      const AB_val = parseInt(`${ac[0]}${ac[1]}`, 10);
      const CD_val = parseInt(`${ac[2]}${ac[3]}`, 10);
      const EF_val = parseInt(`${ac[4]}${ac[5]}`, 10);
      let AB_divided, CD_divided, EF_divided;
      if (G_val === 0) {
        AB_divided = AB_val; CD_divided = CD_val; EF_divided = EF_val;
      } else {
        AB_divided = Math.floor(AB_val / G_val);
        CD_divided = Math.floor(CD_val / G_val);
        EF_divided = Math.floor(EF_val / G_val);
      }
      const groupABCDEFHIJ = `${String(AB_divided).padStart(2, '0')}${String(CD_divided).padStart(2, '0')}${String(EF_divided).padStart(2, '0')}${HI_modified_str}${ac[9]}`;
      
      // Compare against the displayed/processed code
      if (groupABCDEFHIJ !== this.displayedDeviceCode) {
        this.statusMessage = "激活失败: 设备码不匹配";
        return;
      }
      
      const now = new Date();
      let currentMinutes = now.getMinutes();
      if (currentMinutes <= 9) currentMinutes += 60;
      const GJ_value = parseInt(`${ac[6]}${ac[9]}`, 10);
      const diff = currentMinutes - GJ_value;

      if (diff > 10 || diff < 0) {
        this.statusMessage = `激活失败: 时间校验不通过 (差值: ${diff})`;
        return;
      }
      
      // Step 2: Server Registration using the raw identifier
      this.statusMessage = "本地校验成功，正在注册设备...";
      try {
        // Use rawDeviceId for server communication
        const result = await ApiService.registerAndGetUserId(this.rawDeviceId);

        if (result.success && (result.userInfo?.id || result.userInfo?.user_number)) {
          this.statusMessage = "激活成功！已获取用户ID。";
          await this.handleActivationSuccess(result.userInfo);
        } else {
          if (result.reason === 'user_id_verification_required') {
              this.statusMessage = result.message || '此用户名已存在，请输入用户ID以验证。';
              this.uiState = 'enter_user_id';
          } else {
              this.statusMessage = "激活失败: " + (result.error || "无法从服务器获取用户信息");
          }
        }
      } catch (e) {
        this.statusMessage = "激活失败: 网络请求错误，请重试。";
      }
    }
  }
</script>
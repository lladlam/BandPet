<script>
  import UserService from './common/js/userService.js';

  export default {
    async onCreate() {
      console.log('[lifecycle] [app] onCreate - Ensuring user is registered...');
      try {
        const userInfo = await UserService.ensureUserIsRegistered();
        if (userInfo) {
          console.log('[lifecycle] [app] User registration confirmed successfully.');
        } else {
          console.error('[lifecycle] [app] Failed to confirm user registration.');
          // In a real app, you might want to show a non-closable error page here.
          // For now, we'll let it proceed, but features requiring a user ID may fail.
        }
      } catch (e) {
        console.error('A critical error occurred during app startup in app.ux:', e);
      }
    },

    onShow() {
      console.log('[lifecycle] [app] onShow');
    },

    onHide() {
      console.log('[lifecycle] [app] onHide');
    },

    onDestroy() {
      console.log('[lifecycle] [app] onDestroy');
    },

    onError(err) {
      console.log(`[lifecycle] [app] onError errmsg: ${err.message}`);
      console.log(`[lifecycle] [app] onError error stack: ${err.stack}`);
    }
  }
</script>

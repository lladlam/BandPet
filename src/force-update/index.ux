<template>
  <div class="force-update-container">
    <div class="update-content">
      <text class="update-title">{{updateInfo.title || '发现新版本'}}</text>
      <text class="version-text">新版本: {{updateInfo.version_name}}</text>
      
      <div class="changelog-container">
        <text class="changelog-title">更新内容:</text>
        <scroll class="changelog-scroll">
          <text class="changelog-text">{{updateInfo.changelog}}</text>
        </scroll>
      </div>
      
      <div class="force-notice">
        <text class="force-notice-text">此版本为强制更新, 请去更新最新版本即可</text>
      </div>
      
      <div class="check-button" onclick="relaunchApp">
        <text class="check-button-text">我已更新, 点击继续</text>
      </div>
    </div>
  </div>
</template>

<style>
  .force-update-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: #000000;
    padding: 40px;
  }
  
  .update-content {
    flex: 1;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .update-title {
    font-size: 36px;
    color: #FFFFFF;
    margin-bottom: 20px;
    text-align: center;
    font-weight: bold;
  }
  
  .version-text {
    font-size: 28px;
    color: #AAAAAA;
    margin-bottom: 40px;
  }
  
  .changelog-container {
    width: 100%;
    flex-direction: column;
    margin-bottom: 40px;
  }
  
  .changelog-title {
    font-size: 32px;
    color: #FFFFFF;
    margin-bottom: 20px;
    font-weight: bold;
  }
  
  .changelog-scroll {
    width: 100%;
    height: 250px;
    padding: 20px;
    background-color: #1a1a1a;
    border-radius: 10px;
    margin-bottom: 20px;
  }
  
  .changelog-text {
    font-size: 28px;
    color: #DDDDDD;
    line-height: 40px;
  }
  
  .force-notice {
    width: 100%;
    padding: 20px;
    background-color: #2b0000;
    border-radius: 10px;
    margin-bottom: 30px;
    border: 2px solid #F44336;
  }
  
  .force-notice-text {
    font-size: 28px;
    color: #FF8A80;
    text-align: center;
    font-weight: bold;
  }

  .check-button {
    width: 80%;
    height: 80px;
    background-color: #4CAF50;
    border-radius: 40px;
    justify-content: center;
    align-items: center;
  }
  
  .check-button-text {
    font-size: 30px;
    color: #FFFFFF;
    font-weight: bold;
  }
</style>

<script>
  import router from '@system.router';
  import prompt from '@system.prompt';
  import BackInterceptor from '../common/js/back-interceptor.js';

  export default {
    data: {
      updateInfo: {},
    },
    onInit() {
      // 从页面参数获取更新信息
      this.updateInfo = this.$page.param.updateInfo || {};
      // 启用返回拦截，用户无法返回
      BackInterceptor.intercept('请先完成应用更新');
    },
    
    // 用户点击“我已更新”
    relaunchApp() {
      prompt.showToast({
        message: '正在重启应用...',
        duration: 1500
      });
      // 替换到主页，app.ux中的逻辑会再次检查更新
      // 如果用户真的更新了，就能正常进入
      // 如果没更新，会再次被拦截到这个页面
      setTimeout(() => {
        router.replace({
          uri: '/main'
        });
      }, 1500);
    },

    onDestroy() {
      // 在页面销毁时（理论上不应该发生，除非更新成功）恢复返回键功能
      BackInterceptor.restore();
    }
  }
</script>

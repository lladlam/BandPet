  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">激活</text>
        </div>
      </div>
    </div>
    
    <scroll class="content-scroll-container">
      <div class="page-content">
        <div class="device-code-section">
          <text>您的设备码为</text>
          <div class="code-box">
            <text>{{ deviceCode }}</text>
          </div>
        </div>
        <div class="activation-code-section">
          <text>激活码</text>
          <div class="input-box">
            <text>{{ activationCode || '点击输入' }}</text>
          </div>
        </div>

        <div class="actions">
          <!-- T9 Keyboard -->
          <div class="t9-keyboard">
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '1'}})">
                <image src="../common/1.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '2'}})">
                <image src="../common/2.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '3'}})">
                <image src="../common/3.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '4'}})">
                <image src="../common/4.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '5'}})">
                <image src="../common/5.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '6'}})">
                <image src="../common/6.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '7'}})">
                <image src="../common/7.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '8'}})">
                <image src="../common/8.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '9'}})">
                <image src="../common/9.png" class="key-icon"></image>
              </div>
            </div>
            <div class="keyboard-row">
              <div class="key" onclick="handleKeyClick({detail: {value: '⌫'}})">
                <image src="../common/del.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '0'}})">
                <image src="../common/0.png" class="key-icon"></image>
              </div>
              <div class="key" onclick="handleKeyClick({detail: {value: '✓'}})">
                <image src="../common/SmallCheck.png" class="key-icon"></image>
              </div>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <text class="status-text">{{ statusMessage }}</text>
  </div>
</template>

<style>
  /* ... existing styles ... */
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    /* No align-items: center here, let page-header handle it */
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
    margin-top: 0;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start; /* Align items to the start */
    margin-top: 10px;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    margin-right: 10px; /* Add some space between back button and title/time */
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px; /* Adjusted from 40px */
  }
  /* .page-header-spacer is removed */
  .header-title-time {
    flex-direction: column; /* Stack time and title */
    align-items: flex-start; /* Align time and title to the left within their div */
  }
  .content-scroll-container { /* New scroll container for content */
    flex: 1; /* Take remaining space */
    width: 100%;
  }

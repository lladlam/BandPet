<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">更多</text>
        </div>
      </div>
    </div>
    <div class="page-content">
      <div class="menu-list">
        <div class="menu-item" onclick="goTo('leaderboard')">
          <text class="menu-text">排行榜</text>
        </div>
        <div class="menu-item" onclick="goTo('exchange')">
          <text class="menu-text">物品交换</text>
        </div>
        <div class="menu-item" onclick="goTo('market')">
          <text class="menu-text">物品市场</text>
        </div>
        <div class="menu-item" onclick="goTo('customize')">
          <text class="menu-text">自定义宠物</text>
        </div>
        <div class="menu-item" onclick="goTo('settings')">
          <text class="menu-text">设置</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1E90FF;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .page-header-back-arrow {
    color: #FFFFFF;
    font-size: 50px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
    align-items: center;
  }
  .menu-list {
    flex-direction: column;
    width: 90%;
  }
  .menu-item {
    width: 100%;
    height: 90px;
    border-radius: 20px;
    background-color: #1A1A1A; /* Even darker grey */
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }
  .menu-text {
    color: #FFFFFF;
    font-size: 35px;
  }
</style>

<script>
  import router from '@system.router';
  import { auth } from '../common/js/auth.js';

  export default {
    data: {
      time: '00:00'
    },
    onInit() {
      this.updateTime();
      setInterval(this.updateTime, 60000);
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    goBack() {
      router.back();
    },
    async goTo(page) {
      const protectedRoutes = ['leaderboard', 'exchange', 'market'];
      if (protectedRoutes.includes(page)) {
        const { isActivated } = await auth.getActivationState();
        if (isActivated) {
          router.push({ uri: page });
        } else {
          router.push({ uri: 'activate' });
        }
      } else {
        router.push({ uri: page });
      }
    }
  }
</script>

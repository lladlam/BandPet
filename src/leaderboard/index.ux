<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">排行榜</text>
        </div>
      </div>
    </div>
    <div class="page-content">
      <list class="leaderboard-list" if="{{ rankings.length > 0 }}">
        <list-item for="{{rankings}}" class="list-item">
          <div class="rank-container">
            <text class="rank-number">{{$idx + 1}}</text>
            <text class="rank-name">{{$item.name}}</text>
          </div>
          <text class="rank-score">{{$item.score}}</text>
        </list-item>
      </list>
      <div class="status-container" if="{{ rankings.length === 0 && statusMessage }}">
        <text class="status-text">{{ statusMessage }}</text>
      </div>
    </div>
  </div>
</template>

<style>
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #1E90FF;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
  }
  .page-header-back-arrow {
    color: #FFFFFF;
    font-size: 50px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
    align-items: center;
  }
  .leaderboard-list {
    width: 90%;
    flex-grow: 1;
  }
  .list-item {
    width: 100%;
    height: 80px;
    background-color: #1A1A1A; /* Even darker grey */
    border-radius: 15px;
    margin-bottom: 10px;
    padding: 0 20px;
    justify-content: space-between;
    align-items: center;
  }
  .rank-container {
    align-items: center;
  }
  .rank-number {
    color: #AAAAAA;
    font-size: 30px;
    margin-right: 20px;
  }
  .rank-name {
    color: #FFFFFF;
    font-size: 30px;
  }
  .rank-score {
    color: #FFFFFF;
    font-size: 30px;
  }
  .status-container {
    flex: 1;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }
  .status-text {
    color: #AAAAAA;
    font-size: 28px;
    text-align: center;
  }
</style>

<script>
  import router from '@system.router';
  import ApiService from '../common/js/api-service.js';
  import authGuard from '../common/js/auth-guard.js';

  export default {
    data: {
      time: '00:00',
      rankings: [],
      statusMessage: '正在加载...'
    },
    onInit() {
      this.updateTime();
      setInterval(this.updateTime, 5000);
      this.fetchRankings();
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    async fetchRankings() {
      const guardResult = await authGuard.checkNetworkAccess();
      if (!guardResult.canAccess) {
        this.statusMessage = guardResult.message;
        return;
      }

      // If guard passes, userInfo is available in guardResult.userInfo, though getRankings doesn't need it.
      const result = await ApiService.getRankings();
      if (result.success && result.rankings.length > 0) {
        this.rankings = result.rankings;
        this.statusMessage = ''; // Clear status on success
      } else if (result.success && result.rankings.length === 0) {
        this.statusMessage = '排行榜上还没有人，快去点击吧！';
      } else {
        console.error("Failed to fetch rankings:", result.error);
        this.statusMessage = '无法加载排行榜，请稍后重试。';
      }
    },
    goBack() {
      router.back();
    }
  }
</script>
